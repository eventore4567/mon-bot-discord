+def _strip_redundant_local_checks(bot: commands.Bot) -> int:
+    """Retire les checks locaux que la matrice couvre déjà.
+
+    Un check local qui survit est exactement ce qui fait diverger ``+`` et
+    ``/`` : il s'applique aux commandes préfixées et hybrides mais pas à
+    l'arbre slash pur. La matrice étant exhaustive, ils sont redondants.
+    """
+    removed = 0
+    for command in bot.walk_commands():
+        root = command.root_parent or command
+        if normalise(getattr(root, "name", "")) not in access_matrix.KNOWN_COMMANDS:
+            continue
+        for holder in (command, getattr(command, "app_command", None)):
+            if holder is None:
+                continue
+            checks_list = getattr(holder, "checks", None)
+            if not isinstance(checks_list, list):
+                continue
+            keep = [c for c in checks_list if getattr(c, "_sentrix_keep", False)]
+            removed += len(checks_list) - len(keep)
+            checks_list[:] = keep
+    return removed
 
 
