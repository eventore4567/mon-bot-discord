# Token du bot — Discord Developer Portal > Bot
DISCORD_TOKEN=

# OAuth du dashboard — ne jamais committer les vraies valeurs
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Mettre uniquement le domaine de base. Ne pas ajouter /app ni /oauth/callback.
DASHBOARD_PUBLIC_URL=https://mon-bot-discord-production-8944.up.railway.app

# Dans le portail Discord, l'URL de redirection OAuth doit être :
# https://mon-bot-discord-production-8944.up.railway.app/oauth/callback
# Le lien public à partager avec les membres est :
# https://mon-bot-discord-production-8944.up.railway.app/app

# IA (optionnel)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_MODEL_ADVANCED=gpt-5.6-sol
OPENAI_IMAGE_MODEL=gpt-image-2

# Configuration générale
BOT_PREFIX=+
DATABASE_PATH=database/bot.db
OWNER_IDS=1355855757991481475
