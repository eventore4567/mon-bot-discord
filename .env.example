# Token du bot — Discord Developer Portal > Bot
DISCORD_TOKEN=

# OAuth du dashboard — ne jamais committer les vraies valeurs
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Mettre uniquement le domaine de base. Ne pas ajouter /app ni /oauth/callback.
DASHBOARD_PUBLIC_URL=https://mon-bot-discord-production-8944.up.railway.app
# Optionnel : invitation du serveur Discord de support officiel. Utilisée par /support.
SENTRIX_SUPPORT_URL=

# Dans le portail Discord, l'URL de redirection OAuth doit être :
# https://mon-bot-discord-production-8944.up.railway.app/oauth/callback
# Le lien public à partager avec les membres est :
# https://mon-bot-discord-production-8944.up.railway.app/app

# Annuaires de bots (optionnel).
# Les vraies clés doivent être ajoutées uniquement dans les Variables Railway.
# DiscordBotList : le token est généré sur la fiche du bot, section Admin > Generate token.
# SentriX publie automatiquement les stats toutes les 30 min et les slash commands au
# démarrage. Si DiscordBotList refuse les commands, SentriX réessaie automatiquement
# (1 min, 2 min, 4 min... jusqu'à 10 min) jusqu'à obtenir une réponse HTTP 2xx.
TOPGG_TOKEN=
DISCORDBOTLIST_TOKEN=
# Secret choisi par toi et copié à l'identique dans DiscordBotList > Webhook Secret.
# Il protège /api/discordbotlist/vote. Ce n'est PAS le token API ci-dessus.
DISCORDBOTLIST_WEBHOOK_SECRET=

# IA (optionnel)
OPENAI_API_KEY=
OPENAI_MODEL_FAST=gpt-5.6-luna
OPENAI_MODEL=gpt-5.6-terra
OPENAI_MODEL_ADVANCED=gpt-5.6-sol
OPENAI_IMAGE_MODEL=gpt-image-2
# Concurrence maximale des appels IA et cache court des réglages serveur.
SENTRIX_AI_CONCURRENCY=8
SENTRIX_AI_SETTINGS_CACHE_TTL=20

# Configuration générale
BOT_PREFIX=+
DATABASE_PATH=database/bot.db
OWNER_IDS=1355855757991481475

# Identité par instance (optionnel).
# Sans variable, le service principal garde SentriX. Un service Railway dont le nom contient
# "Odboug" est reconnu automatiquement comme Bot'Odboug.
# BOT_INSTANCE_KEY doit rester stable dans le temps : il sépare Redis/PostgreSQL/snapshots.
# Exemple Bot'Odboug :
# BOT_INSTANCE_KEY=odboug
# BOT_BRAND_LABEL=Odboug
# BOT_DISPLAY_NAME=[+] Bot'Odboug |
# BOT_WAKE_WORDS=Odboug,Bot Odboug,Bot'Odboug
BOT_INSTANCE_KEY=
BOT_BRAND_LABEL=
BOT_DISPLAY_NAME=
BOT_WAKE_WORDS=

# Infrastructure production. Sans ces URLs, SentriX garde ses fallbacks locaux.
# Pour la vraie durabilité et les verrous inter-shards, ajouter les services Railway
# PostgreSQL + Redis et référencer leurs variables dans le service du bot.
POSTGRES_URL=
REDIS_URL=
POSTGRES_POOL_MAX=8

# Reprise automatique du bot de production (deux services, MEME DISCORD_TOKEN).
# Le service principal et le service sentrix-failover utilisent tous les deux
# python railway_boot.py, le meme REDIS_URL, le meme POSTGRES_URL et BOT_INSTANCE_KEY=sentrix.
# Une seule instance se connecte a Discord. Le secours attend puis reprend le lease si
# l'actif tombe. Garder le Canary separe avec son propre CANARY_BOT_TOKEN.
SENTRIX_FAILOVER_ENABLED=0
# Sur le service normal : primary. Sur le service de secours : standby.
SENTRIX_FAILOVER_ROLE=primary
SENTRIX_FAILOVER_LEASE_TTL=20
SENTRIX_FAILOVER_RENEW_INTERVAL=5
SENTRIX_FAILOVER_POLL_INTERVAL=3
# Laisse quelques secondes au service normal pour gagner lors d'un redemarrage simultane.
SENTRIX_FAILOVER_STANDBY_DELAY=8
# Perte de donnees maximale habituelle lors d'un crash brutal : environ cet intervalle.
SENTRIX_FAILOVER_SNAPSHOT_INTERVAL=30

# Réplication complète de la base SQLite principale vers PostgreSQL.
# Snapshot toutes les 15 minutes, conservation des 12 derniers. La restauration est
# automatique uniquement si le fichier local est absent/invalide. Les snapshots sont
# séparés par BOT_INSTANCE_KEY afin qu'un second bot ne puisse jamais restaurer la mauvaise DB.
SENTRIX_PG_SNAPSHOT_INTERVAL=900
SENTRIX_PG_SNAPSHOT_KEEP=12
SENTRIX_RESTORE_FROM_POSTGRES=0

# Sharding : 0 = nombre recommandé déterminé automatiquement par Discord.
SHARD_COUNT=0

# Service Canary séparé. Le service principal garde SENTRIX_CANARY_MODE=0.
# Le service Beta doit exécuter : python railway_canary_boot.py
# CANARY_BOT_TOKEN doit appartenir à une seconde application Discord et être différent
# du token de production.
SENTRIX_CANARY_MODE=0
CANARY_GUILD_ID=0
CANARY_BOT_TOKEN=
CANARY_DATABASE_PATH=database/canary.db

# Sauvegardes catastrophe. Le dossier local fonctionne sans S3 ; pour une sauvegarde
# réellement externe, configurez un bucket S3-compatible.
SENTRIX_BACKUP_DIR=database/backups
SENTRIX_BACKUP_INTERVAL_SECONDS=21600
SENTRIX_BACKUP_RETENTION=14
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Alertes techniques production. Si aucun salon n'est défini, SentriX tente un DM au
# SENTRIX_OPS_ALERT_USER_ID puis au créateur principal. Les erreurs utilisateur normales
# (mauvais argument, cooldown, commande inconnue...) ne déclenchent pas ces alertes.
SENTRIX_OPS_ALERT_CHANNEL_ID=
SENTRIX_OPS_ALERT_USER_ID=
SENTRIX_ALERT_ERROR_THRESHOLD=5
SENTRIX_ALERT_COOLDOWN_SECONDS=900
SENTRIX_ALERT_SLOW_COMMAND_MS=6000
SENTRIX_ALERT_SLOW_DB_MS=1500

# Conservation automatique. Les sanctions/warnings ne sont jamais supprimés par ce job.
SENTRIX_RETENTION_TRANSCRIPTS_DAYS=180
SENTRIX_RETENTION_EVIDENCE_DAYS=365
SENTRIX_RETENTION_DIAGNOSTICS_DAYS=30
SENTRIX_RETENTION_ANALYTICS_DAYS=180
SENTRIX_RETENTION_APPEALS_DAYS=365
