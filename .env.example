# Token du bot — Discord Developer Portal > Bot
DISCORD_TOKEN=

# OAuth du dashboard — ne jamais committer les vraies valeurs
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Mettre uniquement le domaine de base. Ne pas ajouter /app ni /oauth/callback.
DASHBOARD_PUBLIC_URL=https://mon-bot-discord-production-8944.up.railway.app

# Dans le portail Discord, l'URL de redirection OAuth doit être :
# https://mon-bot-discord-production-8944.up.railway.app/oauth/callback
# Le lien public à partager avec les membres est :
# https://mon-bot-discord-production-8944.up.railway.app/app

# IA (optionnel)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_MODEL_ADVANCED=gpt-5.6-sol
OPENAI_IMAGE_MODEL=gpt-image-2

# Configuration générale
BOT_PREFIX=+
DATABASE_PATH=database/bot.db
OWNER_IDS=1355855757991481475

# Infrastructure Enterprise optionnelle. Sans ces URLs, SentriX conserve automatiquement
# SQLite et ses caches locaux ; il n'échoue pas au démarrage.
# Railway peut fournir DATABASE_URL/POSTGRES_URL et REDIS_URL via ses services PostgreSQL/Redis.
POSTGRES_URL=
REDIS_URL=
POSTGRES_POOL_MAX=8

# Sharding : 0 = nombre recommandé déterminé automatiquement par Discord.
SHARD_COUNT=0

# Déploiement canary : à activer uniquement sur un service SentriX Beta séparé.
SENTRIX_CANARY_MODE=0
CANARY_GUILD_ID=0

# Sauvegardes catastrophe. Le dossier local fonctionne sans S3 ; les variables S3 sont
# optionnelles et compatibles avec un stockage objet S3 standard.
SENTRIX_BACKUP_DIR=database/backups
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
