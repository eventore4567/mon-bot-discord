# Control plane. En prod, sentrix_app passe par PgBouncer (port 6432).
DATABASE_URL=postgresql://sentrix_app:app_dev_only@localhost:6432/sentrix
# Migrations : connexion directe (le DDL est incompatible avec le pooling transaction).
MIGRATIONS_DATABASE_URL=postgresql://sentrix_migrator:migrator_dev_only@localhost:5432/sentrix

# >= 32 octets. A generer : python -c "import secrets;print(secrets.token_urlsafe(48))"
SESSION_SECRET=

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:8000/v1/auth/discord/callback
